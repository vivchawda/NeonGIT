const { invoke } = window.__TAURI__.core;

let branchEl;
let outputConsole;

// Helper to write to our custom UI terminal
function printToConsole(text) {
  outputConsole.textContent = text;
}

async function fetchBranch() {
  try {
    const branchName = await invoke("get_current_branch");
    branchEl.textContent = `[${branchName}]`;
  } catch (error) {
    console.error("Failed to get branch:", error);
    branchEl.textContent = "[Not a Git Repo / Error]";
  }
}

async function viewHistory() {
  printToConsole("Fetching history...");
  try {
    const history = await invoke("view_history");
    printToConsole(history || "No history found.");
  } catch (error) {
    printToConsole(`ERROR:\n${error}`);
  }
}

window.addEventListener("DOMContentLoaded", () => {
  branchEl = document.querySelector("#current-branch");
  outputConsole = document.querySelector("#output-console");

  // Wire up the buttons
  document.querySelector("#btn-history").addEventListener("click", viewHistory);

  // Initialize data
  fetchBranch();
});