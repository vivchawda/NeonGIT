:root {
  --bg-color: #0f172a;
  --panel-bg: #1e293b;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --accent: #38bdf8;
  --danger: #ef4444;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: var(--font-sans);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.app-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 20px;
  box-sizing: border-box;
  gap: 20px;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #334155;
  padding-bottom: 10px;
}

h1 {
  margin: 0;
  font-size: 1.5rem;
}

.branch-badge {
  background: var(--panel-bg);
  padding: 6px 12px;
  border-radius: 6px;
  font-family: var(--font-mono);
  font-size: 0.9rem;
  color: var(--accent);
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.btn {
  background: var(--panel-bg);
  color: var(--text-main);
  border: 1px solid #334155;
  padding: 12px;
  border-radius: 8px;
  font-size: 1rem;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn.active {
  border-color: var(--accent);
}

.btn.active:hover {
  background: #2dd4bf20;
  border-color: #2dd4bf;
}

.btn.danger.active {
  border-color: var(--danger);
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.console-wrapper {
  flex-grow: 1;
  background: #000000;
  border-radius: 8px;
  border: 1px solid #334155;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.console-header {
  background: #1e293b;
  padding: 8px 12px;
  font-size: 0.8rem;
  color: var(--text-muted);
  font-family: var(--font-sans);
  border-bottom: 1px solid #334155;
}

#output-console {
  margin: 0;
  padding: 12px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: #a7f3d0;
  overflow-y: auto;
  flex-grow: 1;
  white-space: pre-wrap;
}