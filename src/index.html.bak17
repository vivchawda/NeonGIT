<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon GIT Manager</title>
  <link rel="stylesheet" href="styles.css" />
  <style>
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-content {
      width: 440px;
      max-width: 95%;
      background: var(--sf2);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
      border: 1px solid var(--bd2);
      transition: all 0.3s;
    }

    .rg-label {
      display: flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      color: var(--tm);
      background: var(--sf3);
      padding: 4px 8px;
      border-radius: 4px;
      border: 1px solid var(--bd);
      font-size: 11px;
      transition: all 0.2s;
    }

    .rg-label:has(input:checked) {
      border-color: var(--a2);
      background: rgba(71, 200, 255, 0.1);
      color: var(--a2);
      font-weight: bold;
    }

    .file-item {
      padding: 6px 10px;
      font-size: 11px;
      color: var(--tm);
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--fu);
      border-bottom: 1px solid transparent;
    }

    .file-item:hover {
      background: var(--sf3);
      color: var(--tx);
    }

    .tree-folder {
      cursor: pointer;
      user-select: none;
      font-weight: bold;
      color: var(--tx);
    }

    .tree-folder::before {
      content: '📁';
      font-size: 12px;
    }

    .tree-folder.open::before {
      content: '📂';
      font-size: 12px;
    }

    .tree-file::before {
      content: '📄';
      font-size: 12px;
      opacity: 0.5;
    }

    .tree-children {
      display: none;
      padding-left: 14px;
      border-left: 1px dashed var(--bd);
      margin-left: 11px;
    }

    .tree-children.open {
      display: block;
    }

    @keyframes progress-slide {
      0% {
        transform: translateX(-100%);
      }

      100% {
        transform: translateX(200%);
      }
    }

    .dbf-anim {
      width: 50%;
      animation: progress-slide 1.2s infinite linear;
    }

    #output-console::-webkit-scrollbar {
      width: 6px;
    }

    #output-console::-webkit-scrollbar-thumb {
      background: var(--bd2);
      border-radius: 3px;
    }

    #output-console::-webkit-scrollbar-track {
      background: var(--hd);
    }

    #history-list::-webkit-scrollbar {
      width: 6px;
    }

    #history-list::-webkit-scrollbar-thumb {
      background: var(--bd2);
      border-radius: 3px;
    }

    .main-btn {
      height: 100%;
      width: 100%;
      font-size: 13px;
      justify-content: center;
    }

    .commit-card {
      padding: 12px 16px;
      border-bottom: 1px solid var(--bd);
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: background 0.2s;
      cursor: pointer;
    }

    .commit-card:hover {
      background: var(--sf3);
    }

    .commit-hash {
      display: inline-block;
      background: rgba(232, 255, 71, 0.1);
      color: var(--ac);
      border: 1px solid rgba(232, 255, 71, 0.3);
      padding: 2px 6px;
      border-radius: 4px;
      font-family: var(--fu);
      font-size: 10px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .commit-hash:hover {
      background: var(--ac);
      color: #000;
    }

    .commit-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      color: var(--td);
    }

    .commit-msg {
      font-size: 12px;
      color: var(--tx);
      font-weight: 500;
      line-height: 1.4;
      word-break: break-word;
    }

    .commit-details-panel {
      display: none;
      margin-top: 6px;
      padding-top: 10px;
      border-top: 1px dashed var(--bd);
    }

    .commit-card.expanded .commit-details-panel {
      display: block;
    }
  </style>
</head>

<body>
  <div class="topbar">
    <!-- RESTORED: Clean Logo without MoodCompute text -->
    <div class="logo" style="margin-right: 10px;">
      <div class="ldot"></div> Neon GIT Manager
    </div>

    <select id="repo-dropdown" class="mi"
      style="margin-bottom: 0; padding: 2px 26px 2px 8px; min-height: 24px; font-size: 11px; width: auto; max-width: 200px;"></select>
    <button class="ib" id="btn-select-repo" style="width: 24px; height: 24px; font-size: 14px; margin-left: 4px;"
      title="Add Repository">+</button>
    <div class="spacer"></div>
    <div class="stat"
      style="display: flex; align-items: center; gap: 5px; background: transparent; border: none; padding: 0;">
      <em>Branch:</em> <select id="branch-dropdown" class="mi"
        style="margin-bottom: 0; padding: 2px 26px 2px 8px; min-height: 24px; font-size: 11px; width: auto; max-width: 180px; cursor: pointer;">
        <option value="">--</option>
      </select>
    </div>
    <button class="ib" id="btn-open-about" style="width: 24px; height: 24px; font-size: 12px; margin-left: 8px;"
      title="About Neon GIT Manager">i</button>
  </div>

  <div class="body" style="padding-bottom: 33px; min-height: 0;">
    <div class="main" style="padding: 20px; gap: 15px; display: flex; flex-direction: column; min-height: 0;">
      <div class="dg" style="grid-template-columns: repeat(3, 1fr); grid-auto-rows: 60px; flex-shrink: 0; gap: 12px;">
        <button id="btn-feature" class="btn btn-g active main-btn">1. 🚀 Start Feature</button>
        <button id="btn-commit" class="btn active main-btn">2. 📝 Quick Commit</button>
        <button id="btn-revert" class="btn btn-d active main-btn">3. ⏪ Hard Reset</button>
        <button id="btn-merge" class="btn btn-g active main-btn">4. 🔀 Merge to Main</button>
        <button id="btn-history" class="btn btn-g active main-btn">5. 📜 View History</button>
        <div class="dmw" style="height: 100%; width: 100%;">
          <button id="btn-actions-toggle" class="btn btn-g active main-btn">6. ⚡ Actions ▾</button>
          <div id="actions-menu" class="dm"
            style="bottom: calc(100% + 5px); top: auto; right: 0; left: 0; box-shadow: 0 -8px 28px rgba(0,0,0,0.55);">
            <div class="dms">
              <div class="dmi" id="action-view-repo">📂 View Repository</div>
              <div class="dmi" id="action-sync-android">📱 Sync Android</div>
            </div>
          </div>
        </div>
      </div>

      <div class="spacer"></div>
      <div class="rcard" style="flex-direction: column; height: 160px; flex-shrink: 0; padding-bottom: 5px;">
        <div class="rl" style="display:flex; justify-content:space-between; flex-shrink: 0;">
          <span>Terminal Output</span><span id="loading-spinner" class="ldot"
            style="display:none; background:var(--a4); box-shadow:0 0 10px var(--a4);"></span>
        </div>
        <div style="position: relative; flex: 1; min-height: 0;">
          <pre id="output-console" class="csv-ta"
            style="position: absolute; inset: 0; margin:0; padding: 10px; overflow-y:auto; overflow-x:hidden; white-space:pre-wrap; font-family:var(--fu); color:var(--a5); font-size: 11px; background: var(--hd); border: 1px solid var(--bd);">Awaiting repository selection...</pre>
        </div>
      </div>
    </div>
  </div>

  <div class="sbar" style="position: fixed; bottom: 0; left: 0; right: 0; height: 33px;">
    <div class="sb1"
      style="padding: 0 14px; align-items: center; color: var(--td); font-size: 10px; gap: 8px; height: 100%;">
      <div id="footer-status-dot" style="width: 6px; height: 6px; border-radius: 50%; background: var(--td);"></div>
      <span id="footer-status-text">System Idle</span>
    </div>
  </div>

  <!-- ABOUT MODAL -->
  <div id="about-modal" class="modal-overlay">
    <div class="rcard modal-content" style="flex-direction: column; padding: 0; width: 380px;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">ℹ️ About</span><button id="btn-close-about"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <div
        style="padding: 24px 16px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center;">

        <div style="display: flex; flex-direction: column; align-items: center;">
          <div
            style="font-size: 9px; color: var(--td); text-transform: uppercase; letter-spacing: 2px; font-weight: bold; margin-bottom: 2px;">
            MoodCompute</div>
          <div
            style="font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: var(--ac); display: flex; align-items: center; gap: 8px;">
            <div class="ldot" style="animation: none;"></div> Neon GIT Manager
          </div>
        </div>

        <div style="color: var(--td); font-size: 11px;">Version 0.1.0 (M1 ARM64)</div>
        <p style="color: var(--tm); font-size: 11px; line-height: 1.5; max-width: 280px; margin-top: 8px;">A
          blazing-fast, Rust-powered Git automation tool built specifically for one click workflows.</p>
        <div style="width: 100%; height: 1px; background: var(--bd); margin: 8px 0;"></div>
        <div style="display: flex; flex-direction: column; gap: 6px; font-size: 11px;">
          <a href="https://github.com/YOUR_USERNAME/neon-git" target="_blank"
            style="color: var(--a2); text-decoration: none;">GitHub Repository</a>
          <a href="https://www.moodcompute.com/" target="_blank"
            style="color: var(--a2); text-decoration: none;">www.moodcompute.com</a>
          <a href="mailto:contact@moodcompute.com"
            style="color: var(--a2); text-decoration: none;">contact@moodcompute.com</a>
        </div>

        <div style="margin-top: 12px;">
          <img src="ai-badge.png" alt="Careful AI Use"
            style="width: 90px; height: auto; opacity: 0.85; filter: drop-shadow(0 4px 12px rgba(71, 200, 255, 0.1));">
        </div>

      </div>
    </div>
  </div>

  <!-- START FEATURE MODAL -->
  <div id="feature-modal" class="modal-overlay">
    <div class="rcard modal-content" style="flex-direction: column; padding: 0;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">🚀 Start New Feature</span><button
          id="btn-close-feature"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <form id="feature-form" style="display: flex; flex-direction: column; gap: 12px; padding: 16px;">
        <div style="display: flex; flex-direction: column; gap: 4px;"><label
            style="color: var(--tm); font-size: 10px; text-transform: uppercase;">Feature Name</label><input type="text"
            id="feature-name" class="mi" required placeholder="e.g., camera fixes" style="width: 100%;"><span
            style="font-size: 9px; color: var(--td);">Spaces will be converted to hyphens. "feat/" prefix is
            optional.</span></div>
        <div
          style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--bd);">
          <button type="button" id="btn-cancel-feature" class="btn btn-g">Cancel</button><button type="submit"
            class="btn" style="color: #000;">🌿 Create Branch</button></div>
      </form>
    </div>
  </div>

  <!-- QUICK COMMIT MODAL -->
  <div id="quick-commit-modal" class="modal-overlay">
    <div class="rcard modal-content" style="flex-direction: column; padding: 0; transition: height 0.3s ease;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">📝 Quick Commit Workflow</span><button
          id="btn-close-modal"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <form id="quick-commit-form" style="display: flex; flex-direction: column; gap: 12px; padding: 16px;">
        <div><label style="color: var(--tm); font-size: 10px; text-transform: uppercase;">Commit Type</label>
          <div style="display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap;"><label class="rg-label"><input
                type="radio" name="commit-type" value="feat" style="display:none" checked> feat</label><label
              class="rg-label"><input type="radio" name="commit-type" value="fix" style="display:none">
              fix</label><label class="rg-label"><input type="radio" name="commit-type" value="ui" style="display:none">
              ui</label><label class="rg-label"><input type="radio" name="commit-type" value="refactor"
                style="display:none"> refactor</label><label class="rg-label"><input type="radio" name="commit-type"
                value="chore" style="display:none"> chore</label></div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;"><label
            style="color: var(--tm); font-size: 10px; text-transform: uppercase;">Commit Summary</label><input
            type="text" id="commit-summary" class="mi" required placeholder="e.g., added native dialog picker"
            style="width: 100%;"></div>
        <div style="display: flex; flex-direction: column; gap: 4px;"><label
            style="color: var(--tm); font-size: 10px; text-transform: uppercase;">Details (Optional)</label><textarea
            id="commit-details" class="csv-ta" rows="2" placeholder="Explain the 'why' behind this change..."
            style="width: 100%; min-height: 50px;"></textarea></div>
        <div id="commit-form-buttons"
          style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; padding-top: 12px; border-top: 1px solid var(--bd);">
          <button type="button" id="btn-cancel-modal" class="btn btn-g">Cancel</button><button type="submit" class="btn"
            style="color: #000;">🚀 Ensure & Push</button></div>
      </form>
      <div id="commit-progress-footer"
        style="display: none; flex-direction: column; gap: 10px; padding: 16px; background: var(--sf3); border-top: 1px solid var(--bd); border-radius: 0 0 9px 9px;">
        <div style="display: flex; justify-content: space-between; align-items: center;"><span id="commit-progress-text"
            style="font-size: 10px; color: var(--a2); font-family: var(--fu); max-width: 70%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Initializing
            Engine...</span>
          <div class="dbr" style="margin: 0; width: 100px; flex-shrink: 0;">
            <div class="dbt" style="background: var(--bd2);">
              <div id="commit-progress-bar" class="dbf dbf-anim" style="background: var(--a2);"></div>
            </div>
          </div>
        </div><button type="button" id="btn-commit-done" class="btn btn-g"
          style="display: none; align-self: flex-end; margin-top: 5px;">Close</button>
      </div>
    </div>
  </div>

  <!-- REPO VIEWER MODAL -->
  <div id="viewer-modal" class="modal-overlay">
    <div class="rcard modal-content"
      style="flex-direction: column; padding: 0; height: 75vh; max-height: 650px; width: 600px;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">📂 Repository Tree</span><button
          id="btn-close-viewer"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <div id="viewer-list" style="flex: 1; overflow-y: auto; background: var(--hd); padding: 10px 0;"></div>
    </div>
  </div>

  <!-- HISTORY MODAL -->
  <div id="history-modal" class="modal-overlay">
    <div class="rcard modal-content"
      style="flex-direction: column; padding: 0; height: 75vh; max-height: 650px; width: 600px;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">📜 Full Git History</span><button
          id="btn-close-history"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <div id="history-list" style="flex: 1; overflow-y: auto; background: var(--sf);"></div>
    </div>
  </div>

  <!-- HARD RESET MODAL -->
  <div id="reset-modal" class="modal-overlay">
    <div class="rcard modal-content" style="flex-direction: column; padding: 0; width: 380px;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--a3); font-size: 11px;">⚠️ DANGER: Hard Reset</span><button
          id="btn-close-reset"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <div style="padding: 16px;">
        <p style="color: var(--tm); font-size: 11px; line-height: 1.5; margin-bottom: 12px;">This will permanently
          destroy all uncommitted changes in your workspace. This action cannot be undone.</p>
        <div style="display: flex; flex-direction: column; gap: 4px;"><label
            style="color: var(--a3); font-size: 10px; font-weight: bold; text-transform: uppercase;">Type "nuke" to
            confirm</label><input type="text" id="reset-input" class="mi" placeholder="nuke"
            style="width: 100%; border-color: rgba(255, 107, 107, 0.3);"></div>
        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;"><button type="button"
            id="btn-cancel-reset" class="btn btn-g">Cancel</button><button type="button" id="btn-confirm-reset"
            class="btn btn-d" disabled>💥 NUKE WORKSPACE</button></div>
      </div>
    </div>
  </div>

  <!-- MERGE MODAL -->
  <div id="merge-modal" class="modal-overlay">
    <div class="rcard modal-content" style="flex-direction: column; padding: 0;">
      <div class="rl"
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--bd); padding: 12px 16px;">
        <span style="font-weight: bold; color: var(--tx); font-size: 11px;">🔀 Merge to Main</span><button
          id="btn-close-merge"
          style="background: transparent; border: none; color: var(--td); cursor: pointer; font-size: 14px;">✕</button>
      </div>
      <div id="merge-screen-1" style="padding: 16px;">
        <p style="color: var(--tm); font-size: 11px; line-height: 1.5; margin-bottom: 16px;">You are about to merge
          <strong id="merge-source-branch" style="color: var(--a2);">--</strong> into the primary branch and push to
          origin.</p>
        <div style="display: flex; justify-content: flex-end; gap: 8px;"><button type="button" id="btn-cancel-merge"
            class="btn btn-g">Cancel</button><button type="button" id="btn-confirm-merge" class="btn">🔀 Execute
            Merge</button></div>
      </div>
      <div id="merge-screen-progress"
        style="display: none; flex-direction: column; gap: 10px; padding: 16px; background: var(--sf3); border-radius: 0 0 9px 9px;">
        <div style="display: flex; justify-content: space-between; align-items: center;"><span id="merge-progress-text"
            style="font-size: 10px; color: var(--a2); font-family: var(--fu); max-width: 70%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Initializing
            Merge...</span>
          <div class="dbr" style="margin: 0; width: 100px; flex-shrink: 0;">
            <div class="dbt" style="background: var(--bd2);">
              <div id="merge-progress-bar" class="dbf dbf-anim" style="background: var(--a2);"></div>
            </div>
          </div>
        </div><button type="button" id="btn-merge-error-close" class="btn btn-g"
          style="display: none; align-self: flex-end; margin-top: 5px;">Close</button>
      </div>
      <div id="merge-screen-3" style="display: none; padding: 16px; background: rgba(74, 222, 128, 0.05);">
        <p style="color: #4ade80; font-size: 11px; font-weight: bold; margin-bottom: 8px;">✅ Merge Successful!</p>
        <p style="color: var(--tm); font-size: 11px; line-height: 1.5; margin-bottom: 16px;">Would you like to
          forcefully delete the local branch <strong id="merge-delete-branch-name" style="color: var(--tx);">--</strong>
          to keep your workspace clean?</p>
        <div style="display: flex; justify-content: flex-end; gap: 8px;"><button type="button" id="btn-keep-branch"
            class="btn btn-g">Keep Branch</button><button type="button" id="btn-delete-branch" class="btn btn-d">🗑️
            Delete Branch</button></div>
      </div>
    </div>
  </div>

  <script type="module" src="/main.js"></script>
</body>

</html>