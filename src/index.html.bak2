<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon Git</title>
  <link rel="stylesheet" href="styles.css" />
</head>

<body>
  <div class="app-container">
    <header>
      <h1>🤖 Neon Git</h1>
      <div class="branch-badge">
        Branch: <span id="current-branch">Loading...</span>
      </div>
    </header>

    <main class="menu-grid">
      <button id="btn-feature" class="btn" disabled>1. 🚀 Start New Feature</button>
      <button id="btn-commit" class="btn" disabled>2. 📝 Quick Commit</button>
      <button id="btn-revert" class="btn danger" disabled>3. ⏪ Revert (Hard Reset)</button>
      <button id="btn-merge" class="btn" disabled>4. 🔀 Merge to Main</button>
      <button id="btn-sync" class="btn" disabled>5. 📱 Sync Android</button>
      <button id="btn-history" class="btn active">6. 📜 View History</button>
    </main>

    <section class="console-wrapper">
      <div class="console-header">Terminal Output</div>
      <pre id="output-console">Waiting for command...</pre>
    </section>
  </div>

  <script type="module" src="/main.js"></script>
</body>

</html>