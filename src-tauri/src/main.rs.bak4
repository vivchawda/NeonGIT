#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]

use std::process::Command;

// Notice the new argument: repo_path
#[tauri::command]
fn get_current_branch(repo_path: String) -> Result<String, String> {
    // We add .current_dir(&repo_path) to anchor the command
    let output = Command::new("git")
        .current_dir(&repo_path)
        .args(["rev-parse", "--abbrev-ref", "HEAD"])
        .output()
        .map_err(|e| format!("Failed to execute process: {}", e))?;

    if output.status.success() {
        let branch = String::from_utf8_lossy(&output.stdout).trim().to_string();
        Ok(branch)
    } else {
        let error = String::from_utf8_lossy(&output.stderr).trim().to_string();
        Err(error)
    }
}

#[tauri::command]
fn view_history(repo_path: String) -> Result<String, String> {
    let output = Command::new("git")
        .current_dir(&repo_path)
        .args(["log", "-n", "5", "--oneline", "--decorate"])
        .output()
        .map_err(|e| format!("Failed to execute process: {}", e))?;

    if output.status.success() {
        let history = String::from_utf8_lossy(&output.stdout).trim().to_string();
        Ok(history)
    } else {
        let error = String::from_utf8_lossy(&output.stderr).trim().to_string();
        Err(error)
    }
}

fn main() {
    tauri::Builder::default()
        // Register the dialog plugin we installed
        .plugin(tauri_plugin_dialog::init())
        .invoke_handler(tauri::generate_handler![get_current_branch, view_history])
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}
